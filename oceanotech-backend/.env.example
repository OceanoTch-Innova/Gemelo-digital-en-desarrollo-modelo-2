# Copia este archivo a ".env" y cambia todos los valores antes de correr en producción.

PORT=4000
NODE_ENV=development

# Origen(es) permitidos para CORS, separados por coma (ej: la URL donde vive tu login.html)
CORS_ORIGIN=http://localhost:5500

# Directorio/archivo SQLite. En producción, usa almacenamiento persistente.
# DB_PATH=

# Secretos para firmar los tokens. Genera valores largos y aleatorios, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_valor_por_uno_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_este_otro_valor_tambien_largo_y_distinto

# Duración de los tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Política de bloqueo de cuenta por intentos fallidos
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# --- reCAPTCHA (para cuando lo actives) ---
# Déjalo vacío por ahora; cuando lo actives, pon tu clave secreta de Google
# y cambia RECAPTCHA_ENABLED a "true" en auth.js / recaptcha.js
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ENABLED=false

# Opcional: cuenta demo sólo si se configuran valores propios.
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=
